<span class="god-sk-cost {{#if maxed}}max{{/if}}" data-tooltip="{{#if maxed}}Максимальний рівень{{else}}Вартість наступного рівня{{/if}}">{{#if maxed}}макс{{else}}{{#unless locked}}{{next}}{{/unless}}{{/if}}</span>
{{#if @root.editable}}
<span class="god-sk-btns">
  <button type="button" class="god-sk-pip" data-action="skillDown" data-skill="{{key}}" {{#unless lvl}}disabled{{/unless}} data-tooltip="{{downTip}}">−</button>
  <button type="button" class="god-sk-pip plus" data-action="skillUp" data-skill="{{key}}" {{#if maxed}}disabled{{/if}} {{#if locked}}disabled{{/if}} data-tooltip="{{upTip}}">{{#if locked}}<i class="fa-solid fa-lock"></i>{{else}}+{{/if}}</button>
</span>
{{/if}}
