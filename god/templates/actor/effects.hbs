<section class="god-tab {{#if tabActive}}active{{/if}}" data-tab-panel="effects">
  <section class="god-panel">
    <header><h3><i class="fa-solid fa-bolt"></i> Діють <small class="god-dim">{{effectsActive.length}}</small></h3>
      {{#if editable}}<button type="button" class="god-btn god-btn-sm" data-action="effectCreate"><i class="fa-solid fa-plus"></i> Ефект</button>{{/if}}</header>
    <div class="god-eff-grid">
      {{#each effectsActive}}{{> god-effect-card}}{{else}}
      <p class="god-empty">Нічого не діє.{{#if @root.editable}} Додай ефект — з шаблону правил (втома, травми, алкоголь…) або свій.{{/if}}</p>
      {{/each}}
    </div>
  </section>
  {{#if effectsOff.length}}
  <section class="god-panel">
    <header><h3><i class="fa-solid fa-moon"></i> Не діють <small class="god-dim">{{effectsOff.length}}</small></h3></header>
    <div class="god-eff-grid">{{#each effectsOff}}{{> god-effect-card off=true}}{{/each}}</div>
  </section>
  {{/if}}
</section>
