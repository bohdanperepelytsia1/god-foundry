<section class="god-tab {{#if tabActive}}active{{/if}}" data-tab-panel="overview">
  {{!-- Бойові показники: як на сайті — усе редагується одразу, з формулами (-20, +5, *2) --}}
  <section class="god-panel god-foe-stats">
    <header><h3><i class="fa-solid fa-skull-crossbones"></i> Показники</h3>
      <span class="god-dim">поля рахують: допиши -20, +5, *2</span></header>
    <div class="god-foe-pills">
      {{#each foeStats}}
      <label class="god-foe-pill {{cls}}" data-tooltip="{{tip}}">
        <span>{{label}}</span>
        {{#if @root.editable}}<input type="text" inputmode="numeric" data-delta="{{path}}" {{#if min}}data-min="0"{{/if}} value="{{value}}">
        {{else}}<b>{{value}}</b>{{/if}}
        {{#if shown}}<small data-tooltip="{{shownTip}}">→ {{shown}}</small>{{/if}}
      </label>
      {{/each}}
    </div>
  </section>

  {{!-- Атака й таблиця уражень: відсотки від PD/MD --}}
  <section class="god-panel god-foe-attack">
    <header><h3><i class="fa-solid fa-swords"></i> Атака</h3>
      {{#if editable}}<button type="button" class="god-btn" data-action="npcAttack" data-tooltip="Ціль → d20 {{god-signed hitTotal}} проти її ШУ → якщо влучив, урон кидком за сіткою з цієї таблиці"><i class="fa-solid fa-dice-d20"></i> Атакувати</button>{{/if}}
    </header>
    <table class="god-foe-table">
      <thead><tr><th></th>{{#each dmgCols}}<th data-tooltip="{{tip}}">{{pct}}%</th>{{/each}}</tr></thead>
      <tbody>
        {{#each dmgRows}}
        <tr class="{{cls}}"><td data-tooltip="{{tip}}">{{label}}</td>{{#each values}}<td>{{this}}</td>{{/each}}</tr>
        {{else}}
        <tr><td colspan="7" class="god-empty">Вкажи PD або MD — тут з'явиться готовий урон за силою влучання.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  {{#if readySpells.length}}
  <section class="god-panel">
    <header><h3><i class="fa-solid fa-wand-sparkles"></i> Заклинання</h3></header>
    <div class="god-chips">
      {{#each readySpells}}
      <button type="button" class="god-spell-chip" data-item-id="{{id}}" data-action="itemUse" {{#unless castable}}disabled{{/unless}}
        data-tooltip="{{school}} · ПППС {{system.threshold}} · {{system.manaCost}} OM{{#unless castable}} · немає рівня школи{{/unless}}">
        <img src="{{img}}" alt="">{{name}}</button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if abilities.length}}
  <section class="god-panel">
    <header><h3><i class="fa-solid fa-hand-sparkles"></i> Здібності</h3></header>
    <div class="god-chips">
      {{#each abilities}}
      <button type="button" class="god-spell-chip" data-item-id="{{id}}" data-action="itemUse"><img src="{{img}}" alt="">{{name}}</button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <section class="god-panel god-eff-panel">
    <header><h3><i class="fa-solid fa-bolt"></i> Ефекти</h3>
      {{#if editable}}<a class="god-head-add" data-action="effectCreate" data-tooltip="Додати ефект: шаблон з правил або свій"><i class="fa-solid fa-plus"></i></a>{{/if}}</header>
    <div class="god-chips">
      {{#each effectsActive}}
      <span class="god-effect-chip" data-effect-uuid="{{uuid}}" data-tooltip="{{#if changes}}{{changes}}{{else}}{{name}}{{/if}}">
        <a data-action="effectEdit"><img src="{{img}}" alt="">{{name}}{{#if duration}} <small>{{duration}}</small>{{/if}}</a>
        {{#if @root.editable}}<a class="god-chip-x" data-action="effectDelete" data-tooltip="Зняти"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </span>
      {{else}}
      <p class="god-empty">Нічого не діє{{#if editable}} — «+», щоб додати отруту, травму, оглушення чи свій ефект{{/if}}.</p>
      {{/each}}
    </div>
  </section>

</section>
