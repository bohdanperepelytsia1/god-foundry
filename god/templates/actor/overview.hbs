<section class="god-tab {{#if tabActive}}active{{/if}}" data-tab-panel="overview">
  {{#if system.progress.statPoints}}
  <div class="god-banner"><i class="fa-solid fa-dumbbell"></i> Є {{system.progress.statPoints}} очок характеристик —
    {{#if editMode}}розподіли кнопками «+».{{else}}увімкни режим редагування (замок).{{/if}}</div>
  {{/if}}

  {{#if editMode}}
  <div class="god-stats-tools">
    <button type="button" class="god-toggle" data-action="rollStats" data-tooltip="Створення персонажа: 6 кидків 6d6 без найменшого куба, потім розподіл по характеристиках">
      <i class="fa-solid fa-dice"></i> Кинути характеристики</button>
  </div>
  {{/if}}
  <div class="god-stats">
    {{#each stats}}
    <div class="god-stat-tile">
      <a class="god-stat-roll" data-action="rollStat" data-stat="{{key}}" data-tooltip="Перевірка: d20 {{god-signed mod}}">
        <span class="god-stat-abbr">{{abbr}}</span>
        <b class="god-stat-mod">{{god-signed mod}}</b>
        <span class="god-stat-label">{{label}}</span>
      </a>
      {{#if @root.editMode}}
      <div class="god-stat-edit">
        <button type="button" data-action="statDown" data-stat="{{key}}" data-tooltip="−1 (майстер: Shift — без повернення очка)">−</button>
        <input type="text" inputmode="numeric" data-delta="system.stats.{{key}}.value" data-min="0" value="{{base}}" data-tooltip="Число, або -5 / +3 — відняти чи додати{{#if bonus}}. Ще +{{bonus}} від шкіл магії{{/if}}">
        <button type="button" data-action="statUp" data-stat="{{key}}" data-tooltip="+1 за очко характеристик (майстер: Shift — безкоштовно)">+</button>
      </div>
      {{else}}
      <div class="god-stat-value" data-tooltip="{{hint}}{{#if bonus}} · {{base}} + {{bonus}} від шкіл магії{{/if}}">{{value}}{{#if bonus}}<sup class="god-stat-bonus">+{{bonus}}</sup>{{/if}}</div>
      {{/if}}
    </div>
    {{/each}}
  </div>

  <section class="god-panel">
    <header><h3><i class="fa-solid fa-swords"></i> У руках</h3></header>
    {{#if equippedWeapons.length}}
    <div class="god-weapon-cards">
      {{#each equippedWeapons}}
      {{> god-weapon-card}}
      {{/each}}
    </div>
    {{else}}
    <p class="god-empty">Нічого в руках. Візьми зброю на вкладці «Спорядження».</p>
    {{/if}}
  </section>

  <section class="god-panel">
    <header><h3><i class="fa-solid fa-crown"></i> Репутація</h3></header>
    <div class="god-rep">
      {{#each reputation}}
      <label class="god-rep-tile" style="--rep: {{color}}" data-tooltip="{{#if tip}}{{tip}}. {{else}}{{label}}. {{/if}}Введи +1 або -2">
        <input type="text" data-delta="system.reputation.{{key}}" value="{{value}}" {{#if max}}data-min="0" data-max="{{max}}"{{/if}}><span>{{label}}{{#if max}} <small>/ {{max}}</small>{{/if}}</span>
      </label>
      {{/each}}
    </div>
  </section>

  {{#if readySpells.length}}
  <section class="god-panel">
    <header><h3><i class="fa-solid fa-wand-sparkles"></i> Заклинання</h3></header>
    <div class="god-chips">
      {{#each readySpells}}
      <button type="button" class="god-spell-chip" data-item-id="{{id}}" data-action="itemUse" {{#unless castable}}disabled{{/unless}}
        data-tooltip="{{school}} · ПППС {{system.threshold}} · {{system.manaCost}} OM">
        <img src="{{img}}" alt="">{{name}}</button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <section class="god-panel god-eff-panel">
    <header><h3><i class="fa-solid fa-bolt"></i> Ефекти</h3>
      {{#if editable}}<a class="god-head-add" data-action="effectCreate" data-tooltip="Додати ефект: шаблон з правил або свій"><i class="fa-solid fa-plus"></i></a>{{/if}}</header>
    <div class="god-chips">
      {{#each effectsActive}}
      <span class="god-effect-chip" data-effect-uuid="{{uuid}}" data-tooltip="{{#if changes}}{{changes}}{{else}}{{name}}{{/if}}">
        <a data-action="effectEdit"><img src="{{img}}" alt="">{{name}}{{#if duration}} <small>{{duration}}</small>{{/if}}</a>
        {{#if @root.editable}}<a class="god-chip-x" data-action="effectDelete" data-tooltip="Зняти"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </span>
      {{else}}
      <p class="god-empty">Нічого не діє{{#if editable}} — «+», щоб додати втому, травму, алкоголь чи свій ефект{{/if}}.</p>
      {{/each}}
    </div>
  </section>
</section>
