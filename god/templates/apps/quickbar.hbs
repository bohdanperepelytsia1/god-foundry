<div class="god-qb">
  <a class="god-qb-grip" data-tooltip="Перетягни панель · подвійний клік — на місце"><i class="fa-solid fa-grip-vertical"></i></a>
  {{#if missing}}
  {{#if userMode}}
  <span class="god-qb-user" data-tooltip="Персонажа не обрано — показано твої макроси"><i class="fa-solid fa-scroll"></i></span>
  {{else}}
  <span class="god-qb-hint">Обери токен свого персонажа</span>
  {{/if}}
  {{else}}
  <img class="god-qb-portrait" src="{{actor.img}}" alt="" data-action="sheet" data-tooltip="{{actor.name}} — відкрити лист">
  <a class="god-qb-collapse" data-action="collapse" data-tooltip="{{#if collapsed}}Розгорнути{{else}}Згорнути{{/if}}">
    <i class="fa-solid {{#if collapsed}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i></a>

  <div class="god-qb-res">
    {{#each bars}}{{> god-res}}{{/each}}
    {{#if armor.length}}<div class="god-qb-armor">{{#each armor}}{{> god-res}}{{/each}}</div>{{/if}}
  </div>

  {{#unless collapsed}}
  <div class="god-qb-side">
    <div class="god-qb-dodge" data-tooltip="Шанс ухилення"><b>{{dodge}}</b><small>ШУ</small></div>
    <div class="god-qb-stance">
      {{#each stances}}<a class="{{#if active}}active{{/if}}" data-action="stance" data-stance="{{id}}" data-tooltip="{{label}}"><img src="{{icon}}" alt=""></a>{{/each}}
    </div>
  </div>
  {{/unless}}
  {{/if}}

  {{#unless collapsed}}{{#if (or actor userMode)}}
  <div class="god-qb-slots {{#if edit}}editing{{/if}}" data-tooltip-direction="UP">
    {{#each linked}}
    {{#if first}}<span class="god-qb-zone" data-tooltip="{{#if (god-eq zone "hands")}}У руках — як на «Огляді»{{else}}На поясі — як на «Огляді»{{/if}}"><i class="fa-solid {{#if (god-eq zone "hands")}}fa-hand{{else}}fa-grip-lines{{/if}}"></i></span>{{/if}}
    <a class="god-qb-slot god-qb-{{group}} god-qb-linked {{#if dim}}dim{{/if}}" data-slot data-action="use" data-key="{{key}}" data-zone="{{zone}}" data-tooltip="{{tip}} · ПКМ — меню">
      <img src="{{img}}" alt="">{{#if badge}}<em>{{badge}}</em>{{/if}}{{#if equip}}<i class="god-qb-worn fa-solid fa-hand"></i>{{/if}}</a>
    {{/each}}
    {{#if linked.length}}<span class="god-qb-gap god-qb-gap-linked"></span>{{/if}}
    {{#each slots}}
    {{#if gap}}<span class="god-qb-gap"></span>{{/if}}
    {{#if empty}}
    <a class="god-qb-slot god-qb-empty" data-slot data-action="use" data-index="{{index}}" data-key="" data-empty data-tooltip="{{tip}}">{{#if num}}<u>{{num}}</u>{{/if}}<i class="fa-solid fa-plus"></i></a>
    {{else}}
    <a class="god-qb-slot god-qb-{{group}} {{#if dim}}dim{{/if}} {{#if (god-eq equip true)}}worn{{/if}}" data-slot data-action="use" data-index="{{index}}" data-key="{{key}}"{{#if hotSlot}} data-hot-slot="{{hotSlot}}"{{/if}} draggable="true"
       data-tooltip="{{tip}}{{#if @root.edit}} · перетягни на інше місце{{else}} · ПКМ — меню{{/if}}">
      <img src="{{img}}" alt="">{{#if num}}<u>{{num}}</u>{{/if}}{{#if badge}}<em>{{badge}}</em>{{/if}}
      {{#if (god-eq equip true)}}<i class="god-qb-worn fa-solid fa-shirt"></i>{{/if}}
      {{#if @root.edit}}<b class="god-qb-x" data-action="removeSlot" data-tooltip="Прибрати з панелі"><i class="fa-solid fa-xmark"></i></b>{{/if}}</a>
    {{/if}}
    {{/each}}
  </div>
  <div class="god-qb-tools">
    {{#if actor}}
    <a class="god-qb-drop" data-action="pick" data-tooltip="Додати: обрати зі списку або перетягни сюди предмет, заклинання, вміння чи макрос"><i class="fa-solid fa-plus"></i></a>
    <a class="god-qb-reset {{#if edit}}on{{/if}}" data-action="editSlots" data-tooltip="{{#if edit}}Готово{{else}}Розкласти по місцях: номери, порожні місця, прибрати{{/if}}"><i class="fa-solid {{#if edit}}fa-check{{else}}fa-pen{{/if}}"></i></a>
    {{else}}
    <span class="god-qb-drop" data-tooltip="Перетягни сюди макрос"><i class="fa-solid fa-plus"></i></span>
    {{/if}}
    {{#if custom}}<a class="god-qb-reset" data-action="resetSlots" data-tooltip="Повернути автоматичний набір"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
  </div>
  {{#if actor}}<a class="god-qb-tray" data-action="tray" data-tooltip="Панель кидків (Shift+R)"><i class="fa-solid fa-dice-d20"></i></a>{{/if}}
  {{/if}}{{/unless}}
</div>
